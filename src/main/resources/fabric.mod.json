{
	"schemaVersion": 1,
	"id": "gauge",
	"version": "${version}",
	"name": "Gauge",
	"description": "Client-side redstone diagnostics drawn in the world: power levels, output arrows, pulse timing, container fill and comparator output, note blocks, jukeboxes, lecterns, pistons (BUD/QC), doors, rails, tripwires, carts and TNT fuses. Sends no packets.",
	"authors": [
		"Skaffa",
		"Claude (Anthropic)"
	],
	"contact": {
		"homepage": "https://github.com/skaffa/gauge",
		"sources": "https://github.com/skaffa/gauge",
		"issues": "https://github.com/skaffa/gauge/issues"
	},
	"license": "MIT",
	"icon": "assets/gauge/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.gauge.client.GaugeClient"
		],
		"modmenu": [
			"dev.gauge.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "gauge.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
